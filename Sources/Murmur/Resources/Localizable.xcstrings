      }
    },
    "Accurate": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точный"
          }
        }
      }
    },
    "Accurate pass": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точный проход"
          }
        }
      }
    },
    "Accurate pass: re-reading the recording…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точный проход: перечитываю запись…"
          }
        }
      }
    },
    "Accurate: text after you finish": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точный: текст после того, как вы закончите"
          }
        }
      }
    },
    "After recording stops, a local model fixes spelling, grammar and punctuation. It picks its language from the audio, not from your language setting.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После остановки записи локальная модель исправляет орфографию, грамматику и пунктуацию. Язык она определяет по звуку, а не по настройке языка."
          }
        }
      }
    },
    "After you stop, Whisper detects the spoken language and a language model corrects spelling, punctuation and grammar. Your text stays on this Mac. Model loading follows the setting above; the first download takes longer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После остановки Whisper определяет язык речи, а языковая модель исправляет орфографию, пунктуацию и грамматику. Текст остаётся на этом Mac. Загрузка моделей зависит от настройки выше; первое скачивание занимает больше времени."
          }
        }
      }
    },
    "After you stop, Whisper detects the spoken language and a language model corrects spelling, punctuation and grammar. Your text stays on this Mac. Models download on first use; finishing takes longer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После остановки Whisper определит язык, а языковая модель исправит орфографию, пунктуацию и грамматику. Текст останется на этом Mac. Модели скачаются при первом использовании; обработка займёт больше времени."
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить"
          }
        }
      }
    },
    "Allow Accessibility to type": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Универсальный доступ для печати"
          }
        }
      }
    },
    "Allow the microphone to continue": {
      "localizations": {
        "ru": {
          "stringUnit": {
