    "Applies to all dictation · model in Settings › Post-processing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует на всю диктовку · модель — в «Настройки › Постобработка»."
          }
        }
